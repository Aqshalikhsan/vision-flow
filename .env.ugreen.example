# Copy to .env in the same UGREEN project folder as compose.ugreen.yml.
# Replace 192.168.1.50 with the fixed/reserved IP of your NAS.
VISIONFLOW_PUBLIC_URL=http://192.168.1.50:8080
VISIONFLOW_ALLOWED_ORIGINS=http://192.168.1.50:8080
VISIONFLOW_ALLOWED_HOSTS=192.168.1.50
VISIONFLOW_COOKIE_SECURE=0
VISIONFLOW_BIND_ADDRESS=0.0.0.0
VISIONFLOW_PORT=8080

# Cloudflare Tunnel (only required with compose.cloudflare.yml).
# Create a remotely-managed tunnel, then paste only its eyJ... token here.
CLOUDFLARE_TUNNEL_TOKEN=

# Generate once, store safely, and keep unchanged after upgrades.
VISIONFLOW_OTP_SECRET=replace-with-a-long-random-secret
VISIONFLOW_ALLOW_SELF_REGISTRATION=0
VISIONFLOW_RATE_LIMIT=120
VISIONFLOW_AUTH_RATE_LIMIT=30
VISIONFLOW_AUTH_RATE_WINDOW_SECONDS=300
VISIONFLOW_DB_BUSY_TIMEOUT_MS=30000
VISIONFLOW_REMOTE_QUEUE_TTL_MINUTES=120

# Adjust to installed NAS memory. Leave headroom for UGOS Pro.
VISIONFLOW_MEMORY_LIMIT=6g
VISIONFLOW_SHM_SIZE=1gb
TZ=Asia/Jakarta

# Optional email OTP.
VISIONFLOW_SMTP_HOST=smtp.gmail.com
VISIONFLOW_SMTP_PORT=587
VISIONFLOW_SMTP_USERNAME=
VISIONFLOW_SMTP_PASSWORD=
VISIONFLOW_SMTP_FROM=

# Optional AI assistant.
GEMINI_API_KEY=
VISIONFLOW_GEMINI_MODEL=gemini-3.6-flash
