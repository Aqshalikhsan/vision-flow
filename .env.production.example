# Copy to .env beside compose.yml. Never commit the resulting .env file.
# For automatic HTTPS, point this domain's DNS A/AAAA record to the server.
VISIONFLOW_ADDRESS=salnova.example.com
VISIONFLOW_PUBLIC_URL=https://salnova.example.com
VISIONFLOW_ALLOWED_ORIGINS=https://salnova.example.com
VISIONFLOW_ALLOWED_HOSTS=salnova.example.com,localhost,127.0.0.1
VISIONFLOW_COOKIE_SECURE=1
VISIONFLOW_ALLOW_SELF_REGISTRATION=0

# Generate once and keep it stable across upgrades/backups, for example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
VISIONFLOW_OTP_SECRET=replace-with-a-long-random-secret
VISIONFLOW_RATE_LIMIT=120
VISIONFLOW_AUTH_RATE_LIMIT=30
VISIONFLOW_AUTH_RATE_WINDOW_SECONDS=300
VISIONFLOW_DB_BUSY_TIMEOUT_MS=30000
VISIONFLOW_REMOTE_QUEUE_TTL_MINUTES=120
TZ=Asia/Jakarta

# Optional email OTP configuration.
VISIONFLOW_SMTP_HOST=smtp.gmail.com
VISIONFLOW_SMTP_PORT=587
VISIONFLOW_SMTP_USERNAME=
VISIONFLOW_SMTP_PASSWORD=
VISIONFLOW_SMTP_FROM=

# Optional assistant configuration.
GEMINI_API_KEY=
VISIONFLOW_GEMINI_MODEL=gemini-3.6-flash

# Host port overrides (normally leave unchanged).
VISIONFLOW_HTTP_PORT=80
VISIONFLOW_HTTPS_PORT=443
