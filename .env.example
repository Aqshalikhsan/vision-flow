# Local development template. Copy to .env.local for start.ps1.
# Never commit credentials or production secrets.
VISIONFLOW_REQUIRE_AUTH=1
VISIONFLOW_ALLOW_SELF_REGISTRATION=1
VISIONFLOW_OTP_SECRET=replace-with-at-least-32-random-characters
VISIONFLOW_PUBLIC_URL=http://localhost:5173
VISIONFLOW_COOKIE_SECURE=0
VISIONFLOW_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VISIONFLOW_ALLOWED_HOSTS=localhost,127.0.0.1
VISIONFLOW_RATE_LIMIT=120
VISIONFLOW_AUTH_RATE_LIMIT=30
VISIONFLOW_AUTH_RATE_WINDOW_SECONDS=300
VISIONFLOW_DB_BUSY_TIMEOUT_MS=30000

VISIONFLOW_SMTP_HOST=smtp.gmail.com
VISIONFLOW_SMTP_PORT=587
VISIONFLOW_SMTP_USERNAME=
VISIONFLOW_SMTP_PASSWORD=
VISIONFLOW_SMTP_FROM=

GEMINI_API_KEY=
VISIONFLOW_GEMINI_MODEL=gemini-3.6-flash

# Optional Firebase Admin integration. Use a path valid on this device.
GOOGLE_APPLICATION_CREDENTIALS=
